# Copy to .env.local (never commit the real one). Add the same values in Vercel.
# These are the same four values margin and recall use, so you can copy them from recall's .env.local.

# Supabase: Project Settings → Data API (URL) and → API Keys (Publishable key; the legacy anon key also works)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Claude API key from console.anthropic.com. Server only, never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Only this account can use Claude in Cairn
ALLOWED_EMAIL=you@example.com

# Optional: model for Look deeper (default claude-sonnet-5-5) and for Suggest matches (default claude-haiku-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_QUICK_MODEL=claude-haiku-5-5

# Optional: how much Claude "thinks" before answering (low, medium, high, or off). Default low.
# CLAUDE_EFFORT=low
